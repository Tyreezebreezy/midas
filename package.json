{
  "name": "midas",
  "private": true,
  "version": "1.0.0-rc.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "tsc --noEmit",
    "format:check": "prettier --check .",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run format:check && npm run lint && npm test && npm run build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:test": "tauri dev --config src-tauri/tauri.test.conf.json",
    "package": "tauri build --config src-tauri/tauri.prod.conf.json"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "prettier": "^3.9.8",
    "typescript": "^6.0.3",
    "vite": "^8.3.0"
  }
}
